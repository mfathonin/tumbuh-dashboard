{
  "name": "on-budget",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm supa:start",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "supa:start": "pnpm dlx supabase start",
    "postsupa:start": "pnpm supa:setup:local && pnpm supa:typegen:local",
    "supa:stop": "pnpm dlx supabase stop --no-backup",
    "supa:stop:backup": "pnpm dlx supabase stop",
    "supa:setup:local": "pnpm dlx supabase status -o env | ./scripts/mapLocalConf.sh > .env.local",
    "supa:typegen": "pnpm dlx supabase gen types typescript > src/models/supaservice.types.ts",
    "supa:typegen:local": "pnpm dlx supabase gen types typescript --local > src/models/supaservice.types.ts",
    "supa:migration:down": "./scripts/migrateDown.sh",
    "supa:migration:reset": "pnpm dlx supabase db reset --local",
    "supa:migration:push": "pnpm dlx supabase db push"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.1.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
